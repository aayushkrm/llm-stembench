# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# All providers below must be FREE-TIER models only; the code enforces free-model
# allowlists and refuses anything else (zero-paid-spend policy).

# OpenRouter (https://openrouter.ai) — free models only; free tier: 20 rpm / 50 req/day
OPENROUTER_API_KEY=

# Opencode Zen (https://opencode.ai/zen) — free models only
OPENCODE_ZEN_API_KEY=

# Optional: local Ollama server (no key needed; default http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
